
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LN FUSION - Messagerie</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#101014;
 color:white;
 font-family:Arial,sans-serif;
}
header{
 padding:18px;
 background:#19191f;
 border-bottom:1px solid #39313f;
 display:flex;
 justify-content:space-between;
 align-items:center;
}
header h2{margin:0;color:#c9a4ff}
main{max-width:850px;margin:25px auto;padding:12px}
.panel{
 background:#19191f;
 border:1px solid #39313f;
 border-radius:15px;
 padding:18px;
 margin-bottom:15px;
}
input,textarea{
 width:100%;
 padding:13px;
 margin:7px 0;
 background:#101014;
 color:white;
 border:1px solid #49404f;
 border-radius:9px;
 font-size:15px;
}
button{
 padding:12px 16px;
 border:0;
 border-radius:9px;
 background:#b77aff;
 color:#160d20;
 font-weight:bold;
 cursor:pointer;
 margin:5px 3px;
}
.secondary{background:#39313f;color:white}
button:disabled{opacity:.5}
.hidden{display:none!important}
#messages,#adminMessages{
 height:350px;
 overflow-y:auto;
 padding:12px;
 background:#101014;
 border:1px solid #39313f;
 border-radius:10px;
}
.message{
 background:#292431;
 padding:11px;
 border-radius:10px;
 margin:9px 0;
 max-width:85%;
 overflow-wrap:anywhere;
}
.message.mine{
 margin-left:auto;
 background:#593b78;
}
.sender{font-weight:bold;color:#d9bdff;font-size:13px}
.small{font-size:12px;color:#aaa}
#status{color:#c9a4ff}
#chatList button{
 display:block;
 width:100%;
 text-align:left;
 background:#292431;
 color:white;
 margin:8px 0;
}
</style>
</head>

<body>

<header>
<h2>LN FUSION 💬</h2>
<button class="secondary" onclick="location.href='index.html'">Boutique</button>
</header>

<main>

<div class="panel" id="authPanel">
<h3>Bienvenue sur la messagerie</h3>
<p class="small">Connecte-toi pour contacter LN FUSION.</p>

<input id="email" type="email" placeholder="Adresse e-mail">
<input id="password" type="password" placeholder="Mot de passe">
<input id="pseudo" type="text" placeholder="Pseudo (pour inscription)">

<button id="loginBtn">Se connecter</button>
<button id="registerBtn" class="secondary">Créer un compte</button>

<p id="authError" class="small"></p>
</div>

<div id="appPanel" class="hidden">

<div class="panel">
<p id="welcome"></p>
<button id="logoutBtn" class="secondary">Déconnexion</button>
</div>

<div class="panel hidden" id="customerPanel">
<h3>Contacter LN FUSION</h3>
<div id="messages"></div>

<textarea id="customerText" maxlength="1000"
placeholder="Écris ton message..."></textarea>

<button id="customerSend">Envoyer</button>
</div>

<div class="panel hidden" id="adminPanel">
<h3>Administration</h3>
<h4>Conversations des clients</h4>
<div id="chatList">Chargement...</div>

<div id="adminConversation" class="hidden">
<h4 id="chatTitle"></h4>
<div id="adminMessages"></div>

<textarea id="adminText" maxlength="1000"
placeholder="Écrire une réponse..."></textarea>

<button id="adminSend">Envoyer la réponse</button>
</div>
</div>

</div>

<p id="status"></p>

</main>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
const firebaseConfig = {
 apiKey: "AIzaSyBiE8FpLUpQR_aJ5oDvI-UtH6QK0Q4FFI",
 authDomain: "ln-fusion.firebaseapp.com",
 projectId: "ln-fusion",
 storageBucket: "ln-fusion.firebasestorage.app",
 messagingSenderId: "169690519454",
 appId: "1:169690519454:web:dea445b9052e52e657288f"
};

const ADMIN_UID = "mIjEcibV09YQr8hofX0FNJJqp572";

firebase.initializeApp(firebaseConfig);

const auth = firebase.auth();
const db = firebase.firestore();
const $ = id => document.getElementById(id);

let user = null;
let selectedChat = null;
let customerListener = null;
let adminListListener = null;
let messageListener = null;

function status(t){$("status").textContent=t}
function error(t){$("authError").textContent=t}

function stopListeners(){
 if(customerListener) customerListener();
 if(adminListListener) adminListListener();
 if(messageListener) messageListener();

 customerListener=null;
 adminListListener=null;
 messageListener=null;
}

function displayMessages(snapshot, container){
 container.innerHTML="";

 snapshot.forEach(doc=>{
  const data=doc.data();

  const box=document.createElement("div");
  box.className="message"+(data.senderId===user.uid?" mine":"");

  const sender=document.createElement("div");
  sender.className="sender";
  sender.textContent=data.senderName||"Utilisateur";

  const content=document.createElement("div");
  content.textContent=data.text||"";

  box.append(sender,content);
  container.appendChild(box);
 });

 container.scrollTop=container.scrollHeight;
}

function listenMessages(chatId, container){
 if(messageListener) messageListener();

 messageListener=db.collection("chats")
 .doc(chatId).collection("messages")
 .orderBy("createdAt","asc")
 .onSnapshot(snapshot=>{
  displayMessages(snapshot,container);
 },e=>status("Erreur : "+e.message));
}

async function sendMessage(chatId, textId, buttonId){
 const message=$(textId).value.trim();
 const button=$(buttonId);

 if(!message)return;

 button.disabled=true;

 try{
  const chatRef=db.collection("chats").doc(chatId);
  const chatSnap=await chatRef.get();

  if(user.uid!==ADMIN_UID&&!chatSnap.exists){
   await chatRef.set({
    ownerUid:user.uid,
    ownerEmail:user.email||"",
    ownerName:user.displayName||"Client",
    createdAt:firebase.firestore.FieldValue.serverTimestamp(),
    lastMessage:message,
    updatedAt:firebase.firestore.FieldValue.serverTimestamp()
   });
  }else{
   await chatRef.set({
    lastMessage:message,
    updatedAt:firebase.firestore.FieldValue.serverTimestamp()
   },{merge:true});
  }

  await chatRef.collection("messages").add({
   text:message,
   senderId:user.uid,
   senderName:user.displayName||user.email||"Utilisateur",
   createdAt:firebase.firestore.FieldValue.serverTimestamp()
  });

  $(textId).value="";
  status("Message envoyé !");
 }catch(e){
  status("Erreur d'envoi : "+e.message);
 }finally{
  button.disabled=false;
 }
}

$("loginBtn").onclick=async()=>{
 error("");
 try{
  await auth.signInWithEmailAndPassword(
   $("email").value.trim(),
   $("password").value
  );
 }catch(e){error(e.message)}
};

$("registerBtn").onclick=async()=>{
 error("");

 const pseudo=$("pseudo").value.trim();
 const email=$("email").value.trim();
 const password=$("password").value;

 if(!pseudo){
  error("Entre un pseudo.");
  return;
 }

 if(password.length<6){
  error("Le mot de passe doit contenir au moins 6 caractères.");
  return;
 }

 try{
  const result=await auth.createUserWithEmailAndPassword(email,password);
  await result.user.updateProfile({displayName:pseudo});
 }catch(e){error(e.message)}
};

$("logoutBtn").onclick=()=>auth.signOut();

$("customerSend").onclick=()=>{
 if(user)sendMessage(user.uid,"customerText","customerSend");
};

$("adminSend").onclick=()=>{
 if(user&&selectedChat){
  sendMessage(selectedChat,"adminText","adminSend");
 }
};

function openCustomer(){
 $("customerPanel").classList.remove("hidden");
 $("adminPanel").classList.add("hidden");

 customerListener=db.collection("chats")
 .doc(user.uid).collection("messages")
 .orderBy("createdAt","asc")
 .onSnapshot(snapshot=>{
  displayMessages(snapshot,$("messages"));
 },e=>status("Erreur : "+e.message));
}

function openAdmin(){
 $("adminPanel").classList.remove("hidden");
 $("customerPanel").classList.add("hidden");

 adminListListener=db.collection("chats")
 .orderBy("updatedAt","desc")
 .onSnapshot(snapshot=>{
  const list=$("chatList");
  list.innerHTML="";

  if(snapshot.empty){
   list.textContent="Aucune conversation.";
   return;
  }

  snapshot.forEach(doc=>{
   const data=doc.data();
   const btn=document.createElement("button");

   btn.textContent=(data.ownerName||"Client")+" — "+
   (data.ownerEmail||"")+" : "+(data.lastMessage||"");

   btn.onclick=()=>{
    selectedChat=doc.id;
    $("adminConversation").classList.remove("hidden");
    $("chatTitle").textContent="Discussion avec "+(data.ownerName||"Client");
    listenMessages(selectedChat,$("adminMessages"));
   };

   list.appendChild(btn);
  });
 },e=>status("Erreur admin : "+e.message));
}

auth.onAuthStateChanged(u=>{
 stopListeners();
 user=u;
 selectedChat=null;

 $("authPanel").classList.toggle("hidden",!!u);
 $("appPanel").classList.toggle("hidden",!u);

 if(!u){
  $("customerPanel").classList.add("hidden");
  $("adminPanel").classList.add("hidden");
  status("");
  return;
 }

 $("welcome").textContent="Connecté : "+(u.displayName||u.email);

 if(u.uid===ADMIN_UID){
  openAdmin();
  status("Mode administrateur activé.");
 }else{
  openCustomer();
  status("Bienvenue dans LN FUSION !");
 }
});
</script>

</body>
</html>
